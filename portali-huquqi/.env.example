# Copy to .env on the server and fill in. Never commit .env.

# Address Caddy serves (see Caddyfile): ":80" while testing by IP, then "new.portali-huquqi.tj",
# and after the switch "portali-huquqi.tj, www.portali-huquqi.tj"
SITE_ADDRESS=:80

# 0 only while testing by plain http://IP (otherwise login does not work); 1 as soon as the site runs on https
COOKIE_SECURE=0

# Full address of the site, used in links inside e-mails
BASE_URL=http://SERVER_IP

# Long random string. Generate with:  openssl rand -hex 32
SECRET_KEY=

# 1 = every new account waits for approval by the authorised body (items 31-32 of the Procedure)
REQUIRE_APPROVAL=1
PORTAL_TZ=Asia/Dushanbe
WEB_WORKERS=3

# Outgoing e-mail (optional; without it messages are only written to the log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_SSL=1   # for port 465
